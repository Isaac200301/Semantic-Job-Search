# Copia este archivo como .env y completa los valores.
# El .env NO se sube al repositorio (ya esta en el .gitignore de la raiz).

# --- Pinecone (OBLIGATORIO) ---
# La misma API key usada en 04_BaseDatosVectorial.ipynb.
# Sin esto, app/config.py lanza RuntimeError y la API ni siquiera arranca.
PINECONE_API_KEY=
PINECONE_INDEX_NAME=ofertas-laborales

# --- Modelo de embeddings ---
# Debe coincidir con el modelo usado para generar los vectores que estan en
# Pinecone. Decision final tomada en 05_Evaluacion_Metricas.ipynb.
MODELO_EMBEDDINGS=all-MiniLM-L6-v2

# --- Descarga automatica de datos (OPCIONAL) ---
# Solo si se usa descargar_datos.py en vez de copiar los parquet a mano.
# Es el ID del archivo en Google Drive: la parte de la URL entre /d/ y /view.
DRIVE_FILE_ID_CLEAN=
DRIVE_FILE_ID_MAPEO=
